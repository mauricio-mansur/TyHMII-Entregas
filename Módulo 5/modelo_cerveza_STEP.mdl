{UTF-8}
Inventario= INTEG (Producción-Ventas,
		100)
	~	
	~		|

Inventario deseado=150 + STEP ( 150 , 4)
	~	
	~		|

Producción=Ventas + (Inventario deseado - Inventario) / Tiempo de Ajuste
	~	
	~		|

Tiempo de Ajuste=2
	~	
	~		|

Ventas=10
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 10
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Week [0,?]
	~	The time step for the simulation.
	|

